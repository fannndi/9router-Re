# 9Router environment contract (lean fork)
# Only the variables the current code actually reads. Copy to `.env` or export directly.

# ── Required
JWT_SECRET=change-me-to-a-long-random-secret      # signs the dashboard session cookie
INITIAL_PASSWORD=change-me                        # first-boot dashboard password (default 123456)
API_KEY_SECRET=endpoint-proxy-api-key-secret      # secret used when hashing issued API keys
MACHINE_ID_SALT=endpoint-proxy-salt               # salt for the internal CLI-token machine id

# ── Runtime
PORT=20128                    # server + dashboard port
HOSTNAME=127.0.0.1            # bind address (Next standalone server)
NODE_ENV=production
DATA_DIR=/var/lib/9router     # where data.sqlite lives (default: ~/.9router/db)

# ── Security / ops
STRICT_SSL=false              # true disables the relax-TLS retry for upstream fetches
TRUST_PROXY=false             # honour X-Forwarded-* when behind a reverse proxy
AUTH_COOKIE_SECURE=false      # set true when the dashboard is served over HTTPS
ENABLE_REQUEST_LOGS=false     # write per-request lines to file (Console Log page works regardless)
LOG_LEVEL=info                # debug | info | warn | error
MODEL_CATALOG_SYNC=true       # daily models.dev catalog sync (context windows / pricing)

# ── Outbound proxy (optional; the Proxy Pools dashboard sets these at runtime)
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
